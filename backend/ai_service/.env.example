# LexSaksham AI Service — Environment Configuration
# Copy this file to .env and adjust values for your deployment

# ============================================================
# Confidence Thresholding
# ============================================================
# Threshold for marking predictions as requiring human review.
# Predictions with confidence < this value get requires_review=true.
# Typical values: 0.5 (aggressive) | 0.6 (balanced) | 0.7 (conservative) | 0.9 (very strict)
ANALYSIS_CONFIDENCE_THRESHOLD=0.6

# ============================================================
# Prediction Logging
# ============================================================
# Path to JSONL file for storing prediction audit trail.
# Each line is a JSON record with prediction metadata, timestamp, top-K, etc.
PREDICTION_LOG_PATH=./logs/predictions.jsonl

# ============================================================
# Temperature Scaling Calibration
# ============================================================
# Path to temperature.json (output from calibrate_temperature.py).
# If file exists, temperature T is loaded and applied for better calibration.
# If missing, T=1.0 (no scaling) is used.
TEMPERATURE_PATH=./models/temperature.json

# ============================================================
# Explainability Method
# ============================================================
# Default method for explainability when not specified in request.
# Options: "attention" (fast, always available) | "lime" (if installed) | "shap" (if installed)
DEFAULT_EXPLAIN_METHOD=attention

# ============================================================
# Flask Configuration (Optional)
# ============================================================
# Flask debug mode (do NOT enable in production)
FLASK_DEBUG=False

# Flask host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
# Currently hard-coded in app.py. Update DB_CFG dict for production.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lexshaksham_db
# DB_USER=postgres
# DB_PASSWORD=root
